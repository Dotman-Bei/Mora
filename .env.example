# Public site URL, used in metadata and receipt links.
NEXT_PUBLIC_SITE_URL=https://mora-chi.vercel.app

# Optional overrides. Defaults: SDF testnet RPC and Horizon.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_HORIZON_URL=

# The sponsor: the only key on any server (PRD §13). TESTNET ONLY.
# Its public key must match src/lib/testnet.json. Create both with
#   pnpm setup:testnet
SPONSOR_SECRET=

# Rate-limit counters (optional; without them limits are per instance).
# Server-only; never prefix these with NEXT_PUBLIC_. Table: supabase/migrations/0001_rate.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
