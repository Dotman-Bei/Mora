# Public site URL, used in claim links and metadata.
NEXT_PUBLIC_SITE_URL=https://mora.vercel.app

# RPC providers, comma-separated: primary first, then fallbacks (PRD §10.1).
NEXT_PUBLIC_TESTNET_RPC_URLS=https://soroban-testnet.stellar.org
NEXT_PUBLIC_MAINNET_RPC_URLS=

# WalletConnect (Reown) project ID, needed for phone wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Index (P1). Server-only; never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Testnet faucet key: the only key on any server (PRD §14). TESTNET ONLY.
MORA_FAUCET_SECRET=

# Vercel cron auth for /api/cron/sync.
CRON_SECRET=
